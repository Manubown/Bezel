    "./join": "./src/join.ts",
    "./sessioncode": "./src/sessioncode.ts",
    "./public/*": "./public/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mgc/core": "workspace:*",
    "@mgc/layout": "workspace:*",
    "@mgc/look": "workspace:*",
    "@mgc/sdk": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "vite": "^7.1.0"
  }
}
