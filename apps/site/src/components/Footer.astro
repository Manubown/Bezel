---
// The site's footer, on every page: the two legal pages (spec D18) and the source.
const base = import.meta.env.BASE_URL;
---

<footer>
  <nav aria-label="About this site">
    <a href={`${base}privacy/`}>Privacy</a>
    <a href={`${base}imprint/`}>Imprint</a>
    <a href="https://github.com/Manubown/Bezel">Source code</a>
  </nav>
</footer>

<style>
  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  a {
    display: inline-block;
    padding: 0.6rem 0;
  }
</style>
