---
// Who is responsible for the site and the app (spec D18): the makers' details from `src/makers.ts`, marked blanks
// until they are filled in.
import brand from '../../../../brand.json';
import Detail from '../components/Detail.astro';
import Legal from '../layouts/Legal.astro';
---

<Legal title="Imprint" description={`Who makes and publishes ${brand.name}.`}>
  <h1>Imprint</h1>
  <p>{brand.name} and this site are made and published by:</p>
  <dl>
    <dt>Name</dt>
    <dd><Detail of="name" /></dd>
    <dt>Postal address</dt>
    <dd><Detail of="address" /></dd>
    <dt>Country</dt>
    <dd><Detail of="country" /></dd>
    <dt>Contact</dt>
    <dd><Detail of="contact" /></dd>
  </dl>
  <p>
    {brand.name} is open source under the MIT licence; its source code is on <a href="https://github.com/Manubown/Bezel"
      >GitHub</a
    >. The site and the app are published on GitHub Pages. What your phone gives away while you play, and to whom, is on
    the <a href={`${import.meta.env.BASE_URL}privacy/`}>privacy page</a>.
  </p>
</Legal>

<style>
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0 0 0.75rem;
  }
</style>
