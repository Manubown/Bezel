---
// The `stable` tag's build lived here before the app moved below the site: old links, QR codes and installed icons
// go to the app for everyone, with their query.
import brand from '../../../../../brand.json';
import Page from '../../layouts/Page.astro';

const play = `${import.meta.env.BASE_URL}play/`;
---

<Page title="Moved" description={`${brand.name} has moved to ${play}.`}>
  <Fragment slot="first">
    <script is:inline define:vars={{ play }}>
      location.replace(play + location.search);
    </script>
  </Fragment>
  <meta slot="head" name="robots" content="noindex" />

  <main class="column prose">
    <p>{brand.name} has moved: <a href={play}>open it here</a>.</p>
  </main>
</Page>
